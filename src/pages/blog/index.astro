---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import FormattedDate from "../../components/FormattedDate.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout title="Writing" description="Posts on testing, automation, and building reliable software.">
  <p class="eyebrow">Writing</p>
  <h1>Writing</h1>
  <p class="muted intro">
    Notes on testing, automation, backend engineering, and the occasional
    debugging war story. <a href="/tags/">Browse by topic →</a>
  </p>

  {
    posts.length === 0 ? (
      <p class="muted">Nothing published yet — check back soon.</p>
    ) : (
      <ul class="post-list">
        {posts.map((post) => (
          <li>
            <a href={`/blog/${post.id}/`} class="post-card">
              <p class="post-date">
                <FormattedDate date={post.data.pubDate} />
              </p>
              <h2 class="post-title">{post.data.title}</h2>
              {post.data.description && (
                <p class="post-desc">{post.data.description}</p>
              )}
            </a>
          </li>
        ))}
      </ul>
    )
  }
</BaseLayout>

<style>
  .intro {
    max-width: 34rem;
    margin-bottom: 2rem;
  }
  .post-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .post-list li {
    border-top: 1px solid var(--border);
  }
  .post-card {
    display: block;
    padding: 1.5rem 0;
    color: var(--text);
  }
  .post-card:hover {
    text-decoration: none;
  }
  .post-date {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-faint);
    margin: 0 0 0.3rem;
  }
  .post-title {
    margin: 0;
    font-size: 1.3rem;
  }
  .post-card:hover .post-title {
    color: var(--accent);
  }
  .post-desc {
    margin: 0.4rem 0 0;
    color: var(--text-muted);
  }
</style>
