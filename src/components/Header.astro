---
import { NAV_LINKS, SITE_TITLE } from "../consts";
import ThemeToggle from "./ThemeToggle.astro";

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);
---

<header>
  <div class="wrap bar">
    <a href="/" class="brand">{SITE_TITLE}</a>
    <nav aria-label="Primary">
      {
        NAV_LINKS.map((link) => (
          <a
            href={link.href}
            class:list={["nav-link", { active: isActive(link.href) }]}
            aria-current={isActive(link.href) ? "page" : undefined}
          >
            {link.label}
          </a>
        ))
      }
      <ThemeToggle />
    </nav>
  </div>
</header>

<style>
  header {
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: saturate(180%) blur(10px);
    z-index: 50;
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 3.75rem;
  }
  .brand {
    font-weight: 650;
    letter-spacing: -0.02em;
    color: var(--text);
    font-size: 1rem;
  }
  .brand:hover {
    color: var(--accent);
    text-decoration: none;
  }
  nav {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }
  .nav-link {
    color: var(--text-muted);
    font-size: 0.92rem;
    padding: 0.4rem 0.6rem;
    border-radius: 8px;
  }
  .nav-link:hover {
    color: var(--text);
    text-decoration: none;
  }
  .nav-link.active {
    color: var(--accent);
  }
  @media (max-width: 30rem) {
    .brand {
      max-width: 8rem;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .nav-link {
      padding: 0.4rem 0.4rem;
    }
  }
</style>
